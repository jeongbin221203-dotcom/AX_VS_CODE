     "op": "vba",
     "module": "form:frm수강신청",
     "code": "Private Sub UserForm_Initialize()\n    cmb과정.AddItem \"엑셀 실무\"\n    cmb과정.AddItem \"파워BI 입문\"\n    cmb과정.AddItem \"VBA 자동화\"\n    cmb과정.AddItem \"데이터 시각화\"\n    cmb과정.AddItem \"파이썬 기초\"\nEnd Sub\n\nSub cmd등록_Click()\n    Dim r As Long, 수강료 As Double, 할인율 As Double\n    r = Range(\"A3\").CurrentRegion.Rows.Count + 3\n    수강료 = Val(txt수강료.Value)\n    If 수강료 >= 200000 Then\n        할인율 = 0.1\n    Else\n        할인율 = 0.05\n    End If\n    Cells(r, 1).Value = txt성명.Value\n    Cells(r, 2).Value = cmb과정.Value\n    Cells(r, 3).Value = 수강료\n    Cells(r, 4).Value = 할인율\n    Cells(r, 5).Value = 수강료 * (1 - 할인율)\nEnd Sub\n\nPrivate Sub cmd종료_Click()\n    MsgBox Format(Date, \"yyyy-mm-dd\") & \" 작업을 마칩니다.\"\n    Unload Me\nEnd Sub"
    },
