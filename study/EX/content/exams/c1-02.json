     "code": "Private Sub cmd등록_Click()\n    Dim r As Long\n    r = Cells(Rows.Count, 1).End(xlUp).Row + 1\n    Cells(r, 1).Value = Cells(r - 1, 1).Value + 1\n    Cells(r, 2).Value = Range(\"I4\").Value\n    Cells(r, 3).Value = Range(\"I5\").Value\n    Cells(r, 4).Value = Range(\"I6\").Value\n    Cells(r, 5).Value = Range(\"I7\").Value\n    Cells(r, 6).Value = Range(\"I7\").Value * Range(\"I6\").Value\n    Range(\"I4:I7\").ClearContents\nEnd Sub\n\nPrivate Sub cmd조회_Click()\n    Dim 고객 As String, c As Range\n    고객 = InputBox(\"고객명을 입력하세요\")\n    For Each c In Range(\"B4\", Cells(Rows.Count, 2).End(xlUp))\n        If c.Value = 고객 Then\n            MsgBox \"대여료 : \" & Format(c.Offset(0, 4).Value, \"#,##0\") & \"원\"\n            Exit Sub\n        End If\n    Next c\n    MsgBox \"등록되지 않은 고객입니다\"\nEnd Sub\n\nPrivate Sub Worksheet_Activate()\n    Range(\"A1\").Font.Size = 16\n    Range(\"A1\").Font.Bold = True\n    Range(\"I1\").Value = Date\nEnd Sub",
