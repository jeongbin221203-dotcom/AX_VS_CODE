# 이 파일은 scripts/site.py 가 만듭니다 — 직접 고치지 말고 그 파일을 고친 뒤 `python scripts/site.py write` 를 실행하세요.
# Netlify·Cloudflare Pages 형식. 규칙끼리 겹치지 않으므로 어느 쪽이 합쳐도 같은 결과입니다.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: same-origin
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://api.openai.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
/img/*
  Cache-Control: public, max-age=31536000, immutable
/data/sources/*
  Cache-Control: public, max-age=0, must-revalidate
/static/fonts/*
  Cache-Control: public, max-age=86400
/static/favicon.svg
  Cache-Control: public, max-age=86400
/static/ai.js
  Cache-Control: no-cache
/static/app.js
  Cache-Control: no-cache
/static/store.js
  Cache-Control: no-cache
/static/style.css
  Cache-Control: no-cache
/static/theme.js
  Cache-Control: no-cache
/data/answers.js
  Cache-Control: no-cache
/data/catalog.js
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
