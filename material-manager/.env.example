# 자재관리 시스템 운영 설정 견본. 실제 값은 비밀값 저장소(Vault 등)나 서버 환경변수로 넣고, 이 파일을 복사해 쓰지 않는다.
# 설명은 config.py 상단과 README.md 참고.

# ── 필수 ─────────────────────────────────────────────
MM_SECRET_KEY=                      # 모든 서버에 같은 긴 무작위 값 (python -c "import secrets;print(secrets.token_hex(32))")
MM_MFA_KEY=                         # 2단계 인증 비밀키 암호화 키 (세션 키와 다른 값)
MM_COOKIE_SECURE=1                  # HTTPS 뒤에서만 운영
MM_TRUST_PROXY=1                    # 리버스 프록시(nginx·로드밸런서) 뒤일 때만 1

# ── DB · 파일 저장소 ──────────────────────────────────
MM_DATABASE_URL=postgresql://mm_app:비밀번호@db.example.internal:5432/materials   # 비우면 SQLite(한 서버)
MM_DB_POOL_SIZE=10
MM_STORAGE=s3                       # local | s3
MM_S3_BUCKET=
MM_S3_PREFIX=material-manager/
MM_S3_ENDPOINT=                     # AWS가 아니면 S3 호환 주소 (MinIO 등)
MM_S3_REGION=ap-northeast-2

# ── 사내 SSO (OIDC) · 2단계 인증 ─────────────────────
MM_SSO_ENABLED=0
MM_SSO_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
MM_SSO_CLIENT_ID=
MM_SSO_CLIENT_SECRET=
MM_SSO_REDIRECT_URI=https://mm.example.internal/sso/callback
MM_SSO_ROLE_MAP=grp-mm-viewer=VIEWER,grp-mm-clerk=CLERK,grp-mm-manager=MANAGER,grp-mm-admin=ADMIN
MM_SSO_ONLY=0                       # 1이면 비밀번호 로그인은 비상용 시스템관리자만
MM_SSO_REQUIRE_MFA=0
MM_MFA_REQUIRED_ROLES=ADMIN

# ── SAP 연동 ─────────────────────────────────────────
MM_SAP_MODE=off                     # off | mock | http
MM_SAP_ENDPOINT=https://eai.example.internal/sap-mm
MM_SAP_TOKEN=
MM_SAP_MASTER_SYNC=0
MM_SAP_MASTER_READONLY=1

# ── 업무 기준 ────────────────────────────────────────
MM_ADJ_APPROVAL_AMOUNT=500000
MM_VALUATION=MAVG                   # MAVG | FIFO
MM_IDLE_MINUTES=30

# ── 개발 서버 (운영은 waitress-serve) ─────────────────
MM_HOST=127.0.0.1
MM_PORT=5002
MM_DEBUG=0
