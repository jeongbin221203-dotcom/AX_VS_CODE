# 자재관리 시스템 운영 설정 견본. 실제 값은 비밀값 저장소(Vault 등)나 서버 환경변수로 넣고, 이 파일을 복사해 쓰지 않는다.
# 설명은 config.py 상단과 README.md 참고.

# ── 필수 ─────────────────────────────────────────────
MM_SECRET_KEY=                      # 모든 서버에 같은 긴 무작위 값 (python -c "import secrets;print(secrets.token_hex(32))")
MM_COOKIE_SECURE=1                  # HTTPS 뒤에서만 운영
MM_TRUST_PROXY=1                    # 리버스 프록시(nginx·로드밸런서) 뒤일 때만 1

# ── DB · 파일 저장소 ──────────────────────────────────
MM_DATABASE_URL=postgresql://mm_app:비밀번호@db.example.internal:5432/materials   # 비우면 SQLite(한 서버)
MM_DB_POOL_SIZE=10
MM_STORAGE=s3                       # local | s3
MM_S3_BUCKET=
MM_S3_PREFIX=material-manager/
MM_S3_ENDPOINT=                     # AWS가 아니면 S3 호환 주소 (MinIO 등)
MM_S3_REGION=ap-northeast-2
MM_STORAGE_SPOOL_DIR=               # S3 장애 때 파일을 잠시 둘 폴더 (서버가 여러 대면 공유 폴더 권장, 기본: DB 옆 spool)

# ── 자동 백업 (SQLite) ───────────────────────────────
MM_BACKUP_DIR=                      # DB와 다른 디스크·NAS (기본: DB 옆 backups)
MM_BACKUP_HOURS=24                  # 0이면 끔 (PostgreSQL은 DB 서버의 pg_dump)
MM_MRP_HOUR=2                       # MRP 밤 자동 실행 시각(0~23시, 하루 한 번·플랜트마다). -1이면 끔
MM_BACKUP_KEEP=14

# ── 사내 SSO (OIDC) ──────────────────────────────────
MM_SSO_ENABLED=0
MM_SSO_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
MM_SSO_CLIENT_ID=
MM_SSO_CLIENT_SECRET=
MM_SSO_REDIRECT_URI=https://mm.example.internal/sso/callback
MM_SSO_ROLE_MAP=grp-mm-viewer=VIEWER,grp-mm-clerk=CLERK,grp-mm-manager=MANAGER,grp-mm-admin=ADMIN
MM_SSO_ONLY=0                       # 1이면 비밀번호 로그인은 비상용 시스템관리자만 (IdP 장애 때는 'SSO 장애 모드')
MM_SSO_REQUIRE_MFA=0
MM_NEW_USER_ALL_WAREHOUSES=0         # 새 사용자 창고 범위: 0=없음(관리자가 부여), 1=전체

# ── ERP·SAP 연동 (README "ERP·SAP 연동") ─────────────
MM_ERP_MODE=off                     # off | mock | http | sap_odata | sap_rfc | rest | file
# http: 사내 연계서버
MM_SAP_ENDPOINT=https://eai.example.internal/sap-mm
MM_SAP_TOKEN=
# sap_odata · sap_rfc 공통
MM_SAP_CLIENT=100
MM_SAP_USER=
MM_SAP_PASSWORD=
MM_SAP_LANGUAGE=KO
# sap_odata: S/4HANA
MM_SAP_ODATA_URL=https://s4.example.internal:44300
MM_SAP_OAUTH_TOKEN_URL=             # 있으면 OAuth2(클라이언트 자격 증명), 없으면 Basic
MM_SAP_OAUTH_CLIENT_ID=
MM_SAP_OAUTH_CLIENT_SECRET=
MM_SAP_CONTROLLING_AREA=
# sap_rfc: ECC · S/4HANA (pip install pyrfc, SAP NW RFC SDK 필요)
MM_SAP_RFC_ASHOST=
MM_SAP_RFC_SYSNR=00
MM_SAP_RFC_MSHOST=                  # 로드밸런싱이면 MSHOST + SYSID + GROUP
MM_SAP_RFC_SYSID=
MM_SAP_RFC_GROUP=
# rest: 기타 ERP
MM_ERP_REST_URL=https://erp.example.internal
MM_ERP_REST_MAP=erp_maps/generic_example.json
MM_ERP_REST_AUTH=                   # bearer:토큰 | basic:아이디:비밀번호 | header:이름:값
# file: 공유 폴더
MM_ERP_FILE_DIR=
MM_ERP_FILE_FORMAT=json             # json | csv
MM_ERP_UNIT_MAP=                    # 단위 코드 변환, 예: EA:ST,BOX:KAR
MM_ERP_TIMEOUT=15
MM_SAP_MASTER_SYNC=0
MM_SAP_MASTER_READONLY=1

# ── 업무 기준 ────────────────────────────────────────
MM_ADJ_APPROVAL_AMOUNT=500000
MM_VALUATION=MAVG                   # MAVG | FIFO
MM_IDLE_MINUTES=30

# ── 개발 서버 (운영은 waitress-serve, 배치는 flask --app app batch --loop) ──
MM_HOST=127.0.0.1
MM_PORT=5002
MM_DEBUG=0
