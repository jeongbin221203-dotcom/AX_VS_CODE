# docker compose 용 비밀값 — 복사해서 .env 로 쓰고, 저장소에는 올리지 않는다
SALES_SECRET_KEY=change-me-64-hex
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=sales-minio
MINIO_ROOT_PASSWORD=change-me-long
SALES_METRICS_TOKEN=change-me

# 인증: password | sso | oidc
SALES_AUTH_MODE=oidc
SALES_OIDC_METADATA_URL=https://login.example.com/.well-known/openid-configuration
SALES_OIDC_CLIENT_ID=sales-crm
SALES_OIDC_CLIENT_SECRET=change-me
SALES_OIDC_CLAIM=preferred_username
SALES_OIDC_REDIRECT_URL=https://sales.example.com/login/oidc/callback
SALES_OIDC_LOGOUT=1

# 인사 연동 (설정하면 매일 03:00 배치)
SALES_HR_SOURCE=https://hr.example.com/api/sales-feed.json
SALES_HR_TOKEN=change-me

# 결재 기한(시간)
SALES_APPROVAL_SLA_HOURS=48

# ERP · 알림 · 회사 정보(견적서·세금계산서 확인)
SALES_ERP_ADAPTER=file
SALES_SMTP_HOST=smtp.example.com
SALES_NOTIFY_WEBHOOK_URL=
SALES_COMPANY_NAME=
SALES_COMPANY_BIZ_NO=
